model User {
  id           String     @id @default(uuid())
  name         String
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  refreshToken String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  createdDuas  Dua[]      @relation("UserCreatedDuas")
  savedDuas    SavedDua[] @relation("UserSavedDuas")

  @@index([email])
  @@index([username])
  @@map("users")
}
