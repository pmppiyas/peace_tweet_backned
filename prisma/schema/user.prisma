model User {
  id           String      @id @default(uuid())
  name         String
  username     String      @unique
  email        String      @unique
  passwordHash String?
  facebookId   String?     @unique
  authProvider AuthProvider @default(LOCAL)
  role         Role         @default(USER)
  userStatus   UserStatus   @default(NON_VERIFIED)
  badge        String       @default("Standard Member")
  bio          String?      @db.Text
  refreshToken String?      @db.Text
  avatarUrl    String?
  coverUrl     String?
  location     String?
  bloodGroup   BloodGroup?
  isDonor      Boolean      @default(false)
  donationCount Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdDuas            Dua[]              @relation("UserCreatedDuas")
  savedDuas              SavedDua[]         @relation("UserSavedDuas")
  posts                  Post[]             @relation("UserPosts")
  savedPosts             SavedPost[]        @relation("UserSavedPosts")
  reactions              Reaction[]         @relation("UserReactions")
  comments               Comment[]          @relation("UserComments")
  sentFriendRequests     FriendRequest[]    @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]    @relation("ReceivedFriendRequests")
  friendships            Friendship[]       @relation("UserFriendships")
  friendOf               Friendship[]       @relation("FriendOfUser")
  groupMemberships       GroupMember[]      @relation("UserGroupMemberships")
  groupJoinRequests      GroupJoinRequest[] @relation("UserGroupJoinRequests")
  bloodRequestsCreated   BloodRequest[]     @relation("RequesterBloodRequests")
  bloodDonationsGiven    BloodDonation[]    @relation("UserBloodDonations")

  @@index([email])
  @@index([username])
  @@map("users")
}
