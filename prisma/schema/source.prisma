model Source {
  id          String         @id @default(uuid())
  name        String
  type        SourceType
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  duaReferences DuaReference[] @relation("SourceDuaReferences")

  @@index([type])
  @@map("sources")
}
