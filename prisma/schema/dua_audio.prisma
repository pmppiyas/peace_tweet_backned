model DuaAudio {
  id          String   @id @default(uuid())
  duaId       String
  audioUrl    String
  reciterName String?
  duration    Int?
  language    String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dua Dua @relation("DuaAudios", fields: [duaId], references: [id], onDelete: Cascade)

  @@index([duaId])
  @@map("dua_audios")
}
