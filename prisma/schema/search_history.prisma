model SearchHistory {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("UserSearchHistories", fields: [userId], references: [id], onDelete: Cascade)
  query         String
  entityType    SearchEntityType?
  entityId      String?
  entityName    String?
  entityAvatar  String?
  entitySubtext String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("search_histories")
}
