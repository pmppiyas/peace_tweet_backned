model Dua {
  id              String         @id @default(uuid())
  title           String
  fadilah         String         @db.Text
  duaBangla       String         @db.Text
  meaningBangla   String         @db.Text
  arabicText      String?        @db.Text
  transliteration String?        @db.Text
  categoryId      String
  createdById     String
  status          DuaStatus      @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category        Category       @relation("CategoryDuas", fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy       User           @relation("UserCreatedDuas", fields: [createdById], references: [id], onDelete: Restrict)
  references      DuaReference[] @relation("DuaReferences")
  audios          DuaAudio[]     @relation("DuaAudios")
  savedBy         SavedDua[]     @relation("DuaSavedBy")

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@index([status, categoryId])
  @@map("duas")
}
