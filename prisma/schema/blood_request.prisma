model BloodRequest {
  id               String               @id @default(uuid())
  requesterId      String
  requester        User                 @relation("RequesterBloodRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  forMyself        Boolean              @default(false)
  patientName      String
  patientAge       Int?
  problem          String?              @db.Text
  bloodGroup       BloodGroup
  units            Int                  @default(1)
  unitsFulfilled   Int                  @default(0)
  hospitalName     String
  hospitalAddress  String?
  location         String
  contactNumber    String
  alternateContact String?
  neededDate       DateTime
  urgency          BloodRequestUrgency  @default(REGULAR)
  status           BloodRequestStatus   @default(PENDING)
  note             String?              @db.Text

  donations        BloodDonation[]      @relation("BloodRequestDonations")
  posts            Post[]               @relation("BloodRequestPosts")
  shares           Share[]              @relation("BloodRequestShareRecords")

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([bloodGroup])
  @@index([status])
  @@index([location])
  @@index([requesterId])
  @@map("blood_requests")
}
