model Post {
  id         String         @id @default(uuid())
  authorId   String
  type           PostType
  content        String?        @db.Text
  mediaUrls      String[]       @default([])
  mediaLayout    String?        @default("COLLAGE")
  duaId          String?
  bloodRequestId String?
  groupId        String?
  visibility     PostVisibility @default(PUBLIC)
  status         PostStatus     @default(PUBLISHED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author       User          @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  dua          Dua?          @relation("DuaPosts", fields: [duaId], references: [id], onDelete: SetNull)
  bloodRequest BloodRequest? @relation("BloodRequestPosts", fields: [bloodRequestId], references: [id], onDelete: SetNull)
  group        Group?        @relation("GroupPosts", fields: [groupId], references: [id], onDelete: Cascade)
  comments     Comment[]     @relation("PostComments")
  reactions    Reaction[]    @relation("PostReactions")
  savedPosts   SavedPost[]   @relation("PostSaved")

  @@index([authorId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([bloodRequestId])
  @@index([status, visibility, createdAt])
  @@index([groupId, createdAt])
  @@map("posts")
}
