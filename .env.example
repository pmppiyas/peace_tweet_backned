PORT=5000
NODE_ENV=development
APP_NAME="Islamic Dua Platform API"
API_PREFIX=api/v1

DATABASE_URL="postgresql://user:password@localhost:5432/peacetweet?schema=public"

JWT_ACCESS_SECRET="islamic-dua-access-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="islamic-dua-refresh-secret-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
# REDIS_URL="redis://localhost:6379"

# Admin Seed Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"
