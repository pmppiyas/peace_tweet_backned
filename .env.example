# Application
PORT=5000
NODE_ENV=development
APP_NAME="Islamic Dua Platform API"
API_PREFIX=api/v1

# PostgreSQL Database (Docker or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/islamic_dua_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="islamic-dua-access-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="islamic-dua-refresh-secret-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
